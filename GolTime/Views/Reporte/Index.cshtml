@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid py-4 text-white"
     style="background:#020617; min-height:100vh;">

  
    <div class="mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-file-earmark-bar-graph-fill me-2"
               style="color:#6D28D9;"></i>
            Reportes
        </h2>

        <p class="text-secondary mb-0" style="color:white">
            Genera un reporte de las reservaciones en un rango de fechas.
        </p>

    </div>

    <hr class="border-secondary opacity-25">

    
    <div class="card border border-secondary rounded-4 shadow-lg mt-4"
         style="background:#111827;">

        <div class="card-body p-5">

         
            <div class="d-flex align-items-center mb-4">

                

                <div>

                    <h4 class="fw-bold text-white mb-1">
                        Exportar reservaciones
                    </h4>

                    <p class="text-secondary mb-0">
                        Selecciona el rango de fechas para generar el reporte.
                    </p>

                </div>

            </div>

            <hr class="border-secondary opacity-25">

            <div class="row mt-4">

                <div class="col-md-6">

                    <label class="form-label fw-semibold text-white">
                        <i class="bi bi-calendar-event me-2"
                           style="color:#6D28D9;"></i>
                        Fecha inicio
                    </label>

                    <input type="date"
                           class="form-control bg-dark text-white border-secondary py-3">

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold text-white">
                        <i class="bi bi-calendar-check me-2"
                           style="color:#6D28D9;"></i>
                        Fecha fin
                    </label>

                    <input type="date"
                           class="form-control bg-dark text-white border-secondary py-3">

                </div>

            </div>

            <div class="d-flex justify-content-end mt-5">

                <button class="btn text-white fw-semibold px-5 py-3 rounded-3"
                        style="background:#6D28D9;">

                    <i class="bi bi-download me-2"></i>

                    Generar PDF

                </button>

            </div>

        </div>

    </div>

</div>