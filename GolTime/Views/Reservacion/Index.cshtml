@model GolTime.Util.ReservacionPaginacion
@using GolTime.Enums
@{
    ViewData["Title"] = "Reservaciones";
    string estadoActual = ViewBag.EstadoActual;
    string pagoActual = ViewBag.PagoActual;
}

<div class="content-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Reservaciones</h1>
            <p class="panel-subtitle">Administra y consulta todas las reservaciones de la cancha.</p>
        </div>
        <a asp-controller="Reservacion" asp-action="Crear" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
            Nueva reserva
        </a>
    </div>

    <!-- ============ Filtro por estado de la reserva ============ -->
    <div class="filter-bar">
        <span class="filter-label">Estado:</span>
        <a asp-action="Index" asp-route-pago="@pagoActual" class="pill @(string.IsNullOrEmpty(estadoActual) ? "active" : "")">Todas</a>
        <a asp-action="Index" asp-route-estado="Activa" asp-route-pago="@pagoActual" class="pill dot @(estadoActual == "Activa" ? "active" : "")" style="color:var(--green)">Activas</a>
        <a asp-action="Index" asp-route-estado="Finalizada" asp-route-pago="@pagoActual" class="pill dot @(estadoActual == "Finalizada" ? "active" : "")" style="color:var(--blue)">Finalizadas</a>
        <a asp-action="Index" asp-route-estado="Cancelada" asp-route-pago="@pagoActual" class="pill dot @(estadoActual == "Cancelada" ? "active" : "")" style="color:var(--red)">Canceladas</a>
    </div>

    <!-- ============ Filtro por estado de pago ============ -->
    <div class="filter-bar">
        <span class="filter-label">Pago:</span>
        <a asp-action="Index" asp-route-estado="@estadoActual" class="pill @(string.IsNullOrEmpty(pagoActual) ? "active" : "")">Todos</a>
        <a asp-action="Index" asp-route-estado="@estadoActual" asp-route-pago="Pendiente" class="pill dot @(pagoActual == "Pendiente" ? "active" : "")" style="color:var(--amber)">Pendiente</a>
        <a asp-action="Index" asp-route-estado="@estadoActual" asp-route-pago="Pagado" class="pill dot @(pagoActual == "Pagado" ? "active" : "")" style="color:var(--green)">Pagado</a>
    </div>

    <!-- ============ Tabla ============ -->
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Pago</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:var(--text-muted); padding:26px;">
                            No hay reservaciones que coincidan con este filtro.
                        </td>
                    </tr>
                }
                @foreach (var r in Model.Items)
                {
                    var badgeEstado = r.EstadoReserva switch
                    {
                        EstadoReservaEnum.Activa => "badge-activa",
                        EstadoReservaEnum.Finalizada => "badge-finalizada",
                        EstadoReservaEnum.Cancelada => "badge-cancelada",
                        _ => "badge-pendiente"
                    };
                    var badgePago = r.EstadoPago == EstadoPagoEnum.Pagado ? "badge-pagado" : "badge-pendiente";

                    <tr>
                        <td class="cell-strong">@r.HoraInicio.ToString("HH:mm") - @r.HoraFin.ToString("HH:mm")</td>
                        <td>@(r.Client?.Nombre ?? "—")</td>
                        <td>@r.Fecha.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @badgeEstado">@r.EstadoReserva</span></td>
                        <td><span class="badge @badgePago">@r.EstadoPago</span></td>
                        <td>@(r.Client?.Numero ?? "—")</td>
                        <td>
                            <div class="row-actions">
                                <a class="btn-icon edit" asp-controller="Reservacion" asp-action="Editar" asp-route-id="@r.Id" title="Editar">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" /></svg>
                                </a>
                                <a class="btn-icon delete" asp-controller="Reservacion" asp-action="Eliminar" asp-route-id="@r.Id" title="Eliminar">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span>Mostrando @Model.Items.Count de @Model.TotalRegistros reservacion(es)</span>

        @if (Model.TotalPaginas > 1)
        {
            <div class="pagination">
                @if (Model.TienePaginaAnterior)
                {
                    <a class="page-btn" asp-action="Index" asp-route-estado="@estadoActual" asp-route-pago="@pagoActual" asp-route-pagina="@(Model.PaginaActual - 1)">‹</a>
                }
                else
                {
                    <span class="page-btn" style="opacity:.4;">‹</span>
                }

                @for (int p = 1; p <= Model.TotalPaginas; p++)
                {
                    if (p == Model.PaginaActual)
                    {
                        <span class="page-btn active">@p</span>
                    }
                    else
                    {
                        <a class="page-btn" asp-action="Index" asp-route-estado="@estadoActual" asp-route-pago="@pagoActual" asp-route-pagina="@p">@p</a>
                    }
                }

                @if (Model.TienePaginaSiguiente)
                {
                    <a class="page-btn" asp-action="Index" asp-route-estado="@estadoActual" asp-route-pago="@pagoActual" asp-route-pagina="@(Model.PaginaActual + 1)">›</a>
                }
                else
                {
                    <span class="page-btn" style="opacity:.4;">›</span>
                }
            </div>
        }
    </div>
</div>
