@model GolTime.Models.Reservacion
@using GolTime.Enums
@{
    ViewData["Title"] = "Eliminar reserva";

    var badgeEstado = Model.EstadoReserva switch
    {
        EstadoReservaEnum.Activa => "badge-activa",
        EstadoReservaEnum.Finalizada => "badge-finalizada",
        EstadoReservaEnum.Cancelada => "badge-cancelada",
        _ => "badge-pendiente"
    };
    var badgePago = Model.EstadoPago == EstadoPagoEnum.Pagado ? "badge-pagado" : "badge-pendiente";
}

<div class="content-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Eliminar reserva</h1>
            <p class="panel-subtitle">¿Estás seguro de que deseas eliminar esta reserva? Esta acción no se puede deshacer.</p>
        </div>
        <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
            
        </a>
    </div>

    <div class="section-card" style="max-width:520px;">
        <div class="detail-list">
            <div class="detail-row">
                <span class="detail-key">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                    Cliente
                </span>
                <span class="detail-value">@(Model.Client?.Nombre ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-key">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    Fecha
                </span>
                <span class="detail-value">@Model.Fecha.ToString("dd MMM yyyy")</span>
            </div>
            <div class="detail-row">
                <span class="detail-key">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                    Hora
                </span>
                <span class="detail-value">@Model.HoraInicio.ToString("HH:mm") - @Model.HoraFin.ToString("HH:mm")</span>
            </div>
            <div class="detail-row">
                <span class="detail-key">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
                    Pago
                </span>
                <span class="badge @badgePago">@Model.EstadoPago</span>
            </div>
            <div class="detail-row">
                <span class="detail-key">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /></svg>
                    Estado
                </span>
                <span class="badge @badgeEstado">@Model.EstadoReserva</span>
            </div>
        </div>

        <form asp-controller="Reservacion" asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-footer">
                <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">Cancelar</a>
                <button type="submit" class="btn btn-danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
                    Eliminar
                </button>
            </div>
        </form>
    </div>
</div>
