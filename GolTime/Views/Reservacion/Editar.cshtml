@model GolTime.Models.Reservacion
@using GolTime.Enums

@{
    ViewData["Title"] = "Editar reserva";

    var clientes = ViewBag.Clientes as List<GolTime.Models.Cliente>;
    var usuarios = ViewBag.Usuarios as List<GolTime.Models.User>;
}


<div class="content-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Editar reserva</h1>
            <p class="panel-subtitle">
                Modifica los datos de la reserva seleccionada.
            </p>
        </div>
    </div>



    <div class="form-container">

        <form asp-action="Editar" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />



            <div class="form-grid">



                <div class="form-field">

                    <label>
                        Cliente<span class="req">*</span>
                    </label>


                    <div class="input-wrap">

                        <select asp-for="ClientId" required>

                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id">
                                    @c.Nombre — @c.Numero
                                </option>
                            }

                        </select>

                    </div>

                </div>




                <div class="form-field">

                    <label>
                        Atendido por<span class="req">*</span>
                    </label>


                    <div class="input-wrap">

                        <select asp-for="UserId" required>

                            @foreach (var u in usuarios)
                            {
                                <option value="@u.Id">
                                    @u.Nombre
                                </option>
                            }

                        </select>

                    </div>

                </div>




                <div class="form-field">

                    <label>
                        Fecha<span class="req">*</span>
                    </label>


                    <div class="input-wrap">

                        <input asp-for="Fecha"
                               type="date"
                               required />

                    </div>

                </div>



                <div class="form-field"></div>





                <div class="form-field">

                    <label>
                        Hora inicio<span class="req">*</span>
                    </label>


                    <div class="input-wrap">

                        <input asp-for="HoraInicio"
                               type="time"
                               required />

                    </div>

                </div>




                <div class="form-field">

                    <label>
                        Hora fin<span class="req">*</span>
                    </label>


                    <div class="input-wrap">

                        <input asp-for="HoraFin"
                               type="time"
                               required />

                    </div>

                </div>





                <!-- ESTADO RESERVA -->
                <div class="form-field">

                    <label>
                        Estado
                    </label>


                    <div class="input-wrap">

                        <select asp-for="EstadoReserva">

                            @foreach (var val in Enum.GetValues(typeof(EstadoReservaEnum)))
                            {
                                <option value="@val">
                                    @val
                                </option>
                            }

                        </select>

                    </div>

                </div>






                <!-- ESTADO PAGO -->
                <div class="form-field">

                    <label>
                        Pago
                    </label>


                    <div class="input-wrap">

                        <select asp-for="EstadoPago">

                            @foreach (var val in Enum.GetValues(typeof(EstadoPagoEnum)))
                            {
                                <option value="@val">
                                    @val
                                </option>
                            }

                        </select>

                    </div>

                </div>



            </div>





            <div class="modal-footer">


                <a asp-action="Index"
                   class="btn btn-ghost">
                    Cancelar
                </a>



                <button type="submit"
                        class="btn btn-primary">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
                        <path d="M17 21v-8H7v8M7 3v5h8" />

                    </svg>


                    Guardar cambios

                </button>


            </div>


        </form>

    </div>

</div>