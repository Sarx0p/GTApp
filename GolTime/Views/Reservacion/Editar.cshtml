@model GolTime.Models.Reservacion
@using GolTime.Enums
@{
    ViewData["Title"] = "Editar reserva";
    var clientes = ViewBag.Clientes as List<GolTime.Models.Cliente>;
}

<div class="content-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Editar reserva</h1>
            <p class="panel-subtitle">Modifica los datos de la reserva seleccionada.</p>
        </div>
        <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
          
        </a>
    </div>

    <div class="section-card">
        <form asp-controller="Reservacion" asp-action="Editar" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div asp-validation-summary="All" style="color:var(--red); margin-bottom:14px;"></div>

            <div class="form-grid">
                <div class="form-field full">
                    <label>Cliente<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                        <select name="ClientId" required>
                            @foreach (var c in clientes!)
                            {
                                if (c.Id == Model.ClientId)
                                {
                                    <option value="@c.Id" selected>@c.Nombre — @c.Numero</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.Nombre — @c.Numero</option>
                                }
                            }
                        </select>
                    </div>
                </div>


                <div class="form-field">
                    <label>Fecha<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        <input type="date" name="Fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="form-field"></div>

                <div class="form-field">
                    <label>Hora inicio<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                        <input type="time" name="HoraInicio" value="@Model.HoraInicio.ToString("HH:mm")" required />
                    </div>
                </div>
                <div class="form-field">
                    <label>Hora fin<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                        <input type="time" name="HoraFin" value="@Model.HoraFin.ToString("HH:mm")" required />
                    </div>
                </div>

                <div class="form-field">
                    <label>Estado</label>
                    <div class="input-wrap">
                        <select name="EstadoReserva">
                            @foreach (var val in Enum.GetValues(typeof(EstadoReservaEnum)))
                            {
                                if ((EstadoReservaEnum)val == Model.EstadoReserva)
                                {
                                    <option value="@val" selected>@val</option>
                                }
                                else
                                {
                                    <option value="@val">@val</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="form-field">
                    <label>Pago</label>
                    <div class="input-wrap">
                        <select name="EstadoPago">
                            @foreach (var val in Enum.GetValues(typeof(EstadoPagoEnum)))
                            {
                                if ((EstadoPagoEnum)val == Model.EstadoPago)
                                {
                                    <option value="@val" selected>@val</option>
                                }
                                else
                                {
                                    <option value="@val">@val</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>
