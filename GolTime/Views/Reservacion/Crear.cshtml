@model GolTime.Models.Reservacion
@using GolTime.Enums
@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="content-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Nueva reserva</h1>
            <p class="panel-subtitle">Completa los datos para crear una reserva.</p>
        </div>
        <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
            
        </a>
    </div>

    <div class="section-card">
        <form asp-controller="Reservacion" asp-action="Crear" method="post" id="formCrearReserva">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" style="color:var(--red); margin-bottom:14px;"></div>

            <div class="form-grid">
                <div class="form-field full client-combo" id="clienteCombo" data-search-url="@Url.Action("BuscarClientesAjax", "Reservacion")">
                    <label>Cliente<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                        <input type="text" id="clienteSearch" placeholder="Escribe para buscar un cliente..." autocomplete="off" />
                    </div>
                    <input type="hidden" name="ClientId" id="clienteIdHidden" required />
                    <div class="client-combo-empty" id="clienteError" style="display:none; color:var(--red); margin-top:6px;">
                        Selecciona un cliente de la lista (o crea uno nuevo).
                    </div>
                    <div class="client-combo-list" id="clienteList"></div>
                    <button type="button" class="btn-link-inline" id="btnNuevoCliente">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        Nuevo cliente
                    </button>
                </div>

                <div class="form-field">
                    <label>Fecha<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        <input type="date" name="Fecha" id="fechaInput" required />
                    </div>
                </div>
                <div class="form-field"></div>

                <div class="form-field">
                    <label>Hora inicio<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                        <input type="time" name="HoraInicio" required />
                    </div>
                </div>
                <div class="form-field">
                    <label>Hora fin<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                        <input type="time" name="HoraFin" required />
                    </div>
                </div>

                <div class="form-field">
                    <label>Estado</label>
                    <div class="input-wrap">
                        <select name="EstadoReserva">
                            @foreach (var val in Enum.GetValues(typeof(EstadoReservaEnum)))
                            {
                                <option value="@val">@val</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-field">
                    <label>Pago</label>
                    <div class="input-wrap">
                        <select name="EstadoPago">
                            @foreach (var val in Enum.GetValues(typeof(EstadoPagoEnum)))
                            {
                                <option value="@val">@val</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <a asp-controller="Reservacion" asp-action="Index" class="btn btn-ghost">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                    Guardar reserva
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Mini-modal: Nuevo cliente -->
<div class="modal-overlay" id="modalNuevoCliente">
    <div class="modal-box modal-sm">
        <div class="modal-head">
            <div class="modal-head-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3.1-7 7-7s7 3 7 7" /><path d="M18 8v6M15 11h6" /></svg>
                </div>
                <div>
                    <h2 class="modal-title">Nuevo cliente</h2>
                    <p class="modal-subtitle">Se agregará y quedará seleccionado en la reserva.</p>
                </div>
            </div>
            <button type="button" class="modal-close" onclick="GolTime.closeModal('modalNuevoCliente')">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-divider"></div>

        <form id="formNuevoCliente" action="/Reservacion/CrearClienteAjax" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-field full">
                    <label>Nombre<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                        <input type="text" name="nombre" placeholder="Ej. Carlos Pérez" required />
                    </div>
                </div>
                <div class="form-field full">
                    <label>Teléfono<span class="req">*</span></label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.1 2.4Z" /></svg>
                        <input type="text" name="numero" placeholder="Ej. 7200-1234" pattern="[0-9\-\+\s]{7,15}" title="Solo números, espacios, guiones o +." required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="GolTime.closeModal('modalNuevoCliente')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cliente</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var fecha = document.getElementById('fechaInput');
        if (fecha) {
            var hoy = new Date().toISOString().split('T')[0];
            fecha.setAttribute('min', hoy);
        }

        var form = document.getElementById('formCrearReserva');
        var clienteId = document.getElementById('clienteIdHidden');
        var clienteError = document.getElementById('clienteError');

        if (form) {
            form.addEventListener('submit', function (e) {
                if (!clienteId.value) {
                    e.preventDefault();
                    clienteError.style.display = 'block';
                    document.getElementById('clienteSearch').focus();
                }
            });
        }

        if (clienteId) {
            clienteId.addEventListener('change', function () {
                clienteError.style.display = 'none';
            });
        }
    })();
</script>
