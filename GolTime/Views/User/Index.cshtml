@model IEnumerable<GolTime.Models.User>
@using GolTime.Util

@{
    ViewData["Title"] = "Usuarios";
    var roles = ViewBag.Roles as List<GolTime.Models.Rol> ?? new List<GolTime.Models.Rol>();
    var paginacion = ViewBag.Paginacion as UserPaginacion ?? new UserPaginacion();
    int? rolSeleccionado = ViewBag.RolSeleccionado as int?;
    string estadoSeleccionado = ViewBag.EstadoSeleccionado as string ?? "";
    string busqueda = ViewBag.Busqueda as string ?? "";
    string correoUsuarioActual = ViewBag.CorreoUsuarioActual as string ?? "";
    string correoAdminPrincipal = ViewBag.CorreoAdminPrincipal as string ?? "admin@goltime.com";
    int totalRegistros = ViewBag.TotalRegistros as int? ?? Model.Count();
}

<style>
    .users-panel {
        max-width: 1120px;
        min-height: auto;
        padding: 24px 26px 26px;
    }

    .users-panel .panel-header {
        margin-bottom: 20px;
        padding-bottom: 16px;
    }

    .users-panel .panel-title {
        font-size: 24px;
    }

    .users-panel .btn {
        padding: 10px 18px;
        font-size: 14px;
    }

    .users-panel .filter-bar {
        padding: 12px 14px;
        margin-bottom: 18px;
    }

    .users-toolbar {
        display: grid;
        grid-template-columns: minmax(220px, 1.2fr) minmax(170px, .8fr) minmax(170px, .8fr) auto;
        gap: 10px;
        width: 100%;
    }

    .users-toolbar .input-wrap {
        min-height: 42px;
        padding: 9px 12px;
    }

    .users-toolbar input,
    .users-toolbar select {
        min-width: 0;
    }

    .users-panel .data-table thead th {
        padding: 9px 12px;
    }

    .users-panel .data-table tbody td {
        padding: 13px 12px;
    }

    .users-panel .btn-icon {
        width: 34px;
        height: 34px;
    }

    .users-panel .table-footer {
        padding-top: 15px;
    }

    .status-dot {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 600;
        font-size: 13.5px;
    }

    .status-dot::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-dot.active {
        color: var(--green);
    }

    .status-dot.inactive {
        color: var(--text-faint);
    }

    .role-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 11px;
        border-radius: var(--radius-pill);
        color: var(--purple-400);
        background: rgba(109, 40, 217, .18);
        font-size: 12px;
        font-weight: 600;
    }

    .alert-soft {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-md);
        padding: 12px 14px;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .alert-soft.success {
        color: var(--green);
        background: rgba(34, 197, 94, .08);
    }

    .alert-soft.error {
        color: var(--red);
        background: rgba(239, 68, 68, .08);
    }

    .action-disabled {
        opacity: .38;
        cursor: not-allowed;
        pointer-events: none;
    }

    .page-btn.page-wide {
        width: auto;
        padding: 0 10px;
    }

    @@media (max-width: 1050px) {
        .users-toolbar {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 720px) {
        .users-toolbar {
            grid-template-columns: 1fr;
        }

        .users-toolbar .btn {
            width: 100%;
            justify-content: center;
        }

        .panel-header {
            flex-direction: column;
        }
    }
</style>

<div class="content-panel users-panel">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Usuarios</h1>
            <p class="panel-subtitle">Gestiona los empleados y administradores del sistema.</p>
        </div>

        <a asp-controller="User" asp-action="Crear" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
            Nuevo usuario
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert-soft success">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-soft error">@TempData["Error"]</div>
    }

    <form asp-controller="User" asp-action="Index" method="get" class="filter-bar">
        <div class="users-toolbar">
            <div class="input-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" name="busqueda" value="@busqueda" placeholder="Buscar por nombre o correo" />
            </div>

            <div class="input-wrap">
                <select name="rolId">
                    <option value="">Todos los roles</option>
                    @foreach (var rol in roles)
                    {
                        if (rolSeleccionado == rol.Id)
                        {
                            <option value="@rol.Id" selected>@rol.Nombre</option>
                        }
                        else
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    }
                </select>
            </div>

            <div class="input-wrap">
                <select name="estado">
                    @if (string.IsNullOrWhiteSpace(estadoSeleccionado))
                    {
                        <option value="" selected>Todos los estados</option>
                    }
                    else
                    {
                        <option value="">Todos los estados</option>
                    }

                    @if (estadoSeleccionado == "activo")
                    {
                        <option value="activo" selected>Activos</option>
                    }
                    else
                    {
                        <option value="activo">Activos</option>
                    }

                    @if (estadoSeleccionado == "inactivo")
                    {
                        <option value="inactivo" selected>Inactivos</option>
                    }
                    else
                    {
                        <option value="inactivo">Inactivos</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-ghost">Filtrar</button>
        </div>
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Creado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:var(--text-muted); padding:26px;">
                            No hay usuarios registrados con esos filtros.
                        </td>
                    </tr>
                }

                @foreach (var usuario in Model)
                {
                    var correoUsuario = (usuario.Correo ?? string.Empty).Trim().ToLower();
                    var esUsuarioActual = correoUsuario == correoUsuarioActual;
                    var esAdminPrincipal = usuario.Id == 1 || correoUsuario == correoAdminPrincipal;
                    var bloqueoEliminar = esUsuarioActual || esAdminPrincipal;

                    <tr>
                        <td class="cell-strong">@usuario.Nombre</td>
                        <td>@usuario.Correo</td>
                        <td><span class="role-chip">@(usuario.Rol?.Nombre ?? "Sin rol")</span></td>
                        <td>
                            @if (usuario.Estado)
                            {
                                <span class="status-dot active">Activo</span>
                            }
                            else
                            {
                                <span class="status-dot inactive">Inactivo</span>
                            }
                        </td>
                        <td>@usuario.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="row-actions">
                                <a class="btn-icon edit" asp-controller="User" asp-action="Editar" asp-route-id="@usuario.Id" title="Editar usuario">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" /></svg>
                                </a>

                                @if (bloqueoEliminar)
                                {
                                    <span class="btn-icon delete action-disabled" title="Este usuario no se puede eliminar">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
                                    </span>
                                }
                                else
                                {
                                    <a class="btn-icon delete" asp-controller="User" asp-action="Eliminar" asp-route-id="@usuario.Id" title="Eliminar usuario">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (paginacion.TotalPaginas > 1)
    {
        <partial name="_UserPaginacion" model="@paginacion" />
    }
    else
    {
        <div class="table-footer">
            <span>Mostrando @Model.Count() de @totalRegistros usuario(s)</span>
        </div>
    }
</div>
@{
    var usuarioFormulario = ViewBag.UsuarioFormulario as GolTime.Models.User;
}

@if (ViewBag.ModalUsuario == "Crear" && usuarioFormulario != null)
{
    <partial name="Crear" model="@usuarioFormulario" />
}
else if (ViewBag.ModalUsuario == "Editar" && usuarioFormulario != null)
{
    <partial name="Editar" model="@usuarioFormulario" />
}
else if (ViewBag.ModalUsuario == "Eliminar" && usuarioFormulario != null)
{
    <partial name="Eliminar" model="@usuarioFormulario" />
}