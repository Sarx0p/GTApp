@model InfoLogin

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesion";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GolTime</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --login-bg: #020617;
            --login-panel: #111827;
            --login-purple: #6D28D9;
            --login-violet: #8B5CF6;
            --login-blue: #3B82F6;
            --login-border: #CBD5F5;
            --login-text: #FFFFFF;
            --login-muted: #CBD5F5;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: var(--login-text);
            background:
                radial-gradient(circle at 16% 18%, rgba(139, 92, 246, 0.34), transparent 26rem),
                radial-gradient(circle at 88% 78%, rgba(59, 130, 246, 0.22), transparent 24rem),
                var(--login-bg);
        }

        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-shell {
            width: min(980px, 100%);
            min-height: 560px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            background: var(--login-panel);
            border-radius: 4px;
            box-shadow: 0 26px 70px rgba(0, 0, 0, 0.35);
        }

        .login-brand {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            padding: 3rem;
            color: #FFFFFF;
            text-align: center;
            background:
                radial-gradient(circle at 24% 18%, rgba(59, 130, 246, 0.32), transparent 18rem),
                linear-gradient(160deg, #6D28D9 0%, #8B5CF6 55%, #020617 100%);
        }

        .login-brand::after {
            content: "";
            position: absolute;
            inset: 1.25rem;
            border: 1px solid rgba(203, 213, 245, 0.35);
            pointer-events: none;
        }

        .login-logo {
        width: min(500px, 94%);
        height: auto;
        filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.25));
        position: relative;
        z-index: 1;
}

        .login-brand h1 {
            position: relative;
            z-index: 1;
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: 0;
        }

        .login-brand p {
            position: relative;
            z-index: 1;
            max-width: 20rem;
            margin: 0;
            color: rgba(255, 255, 255, 0.88);
            line-height: 1.6;
        }

        .login-form-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
        }

        .login-form {
            width: min(350px, 100%);
        }

        .login-form h2 {
            margin: 0 0 0.5rem;
            font-size: 2rem;
            font-weight: 800;
            color: #FFFFFF;
        }

        .login-form .subtitle {
            margin: 0 0 2rem;
            color: var(--login-muted);
        }

        .form-label {
            color: #FFFFFF;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .form-control {
            min-height: 3.25rem;
            border: 1px solid rgba(203, 213, 245, 0.35);
            border-radius: 3px;
            color: #FFFFFF;
            background: #020617;
        }

        .form-control::placeholder {
            color: rgba(203, 213, 245, 0.7);
        }

        .form-control:focus {
            color: #FFFFFF;
            background: #020617;
            border-color: var(--login-blue);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.18);
        }

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin: 0.75rem 0 1.5rem;
            font-size: 0.95rem;
            color: #FFFFFF;
        }

        .login-options a {
            color: var(--login-violet);
            font-weight: 700;
            text-decoration: none;
        }

        .login-button {
            width: 100%;
            min-height: 3.25rem;
            border: 0;
            border-radius: 3px;
            font-weight: 800;
            color: #FFFFFF;
            background: var(--login-purple);
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .login-button:hover {
            background: var(--login-violet);
            transform: translateY(-1px);
        }

        .login-register {
            margin-top: 1.5rem;
            text-align: center;
            color: var(--login-muted);
        }

        .login-register a {
            color: var(--login-violet);
            font-weight: 800;
            text-decoration: none;
        }

        @@media (max-width: 820px) {
            .login-page {
                padding: 1rem;
            }

            .login-shell {
                grid-template-columns: 1fr;
            }

            .login-brand {
                min-height: 260px;
                padding: 2.25rem 1.5rem;
            }

            .login-form-wrap {
                padding: 2.25rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <main class="login-page">
        <section class="login-shell" aria-label="Formulario de inicio de sesion">
            <div class="login-brand">
    <img src="~/images/logo.png" alt="GolTime" class="login-logo" />
</div>

            <div class="login-form-wrap">
                <form asp-controller="Acceso" asp-action="Login" method="post" class="login-form">
                    @Html.AntiForgeryToken()

                    <h2>Iniciar sesion</h2>
                    <p class="subtitle">Ingresa tus credenciales para continuar.</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Login" class="form-label">Usuario</label>
                        <input asp-for="Login" class="form-control" placeholder="Ingresa tu usuario" autocomplete="username" />
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Password" class="form-label">Contrasena</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Ingresa tu contrasena" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <br>

                    <button type="submit" class="login-button">Ingresar</button>

                    
                </form>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>