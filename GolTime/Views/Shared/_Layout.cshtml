<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GolTime</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GolTime.styles.css" asp-append-version="true" />
</head>

<body style="background:#020617; overflow:hidden;">

    <div class="d-flex">

        
        @Html.Partial("_Sidebar")

        <main class="flex-grow-1 p-5 text-white"
              style="
            margin-left:300px;
            height:100vh;
            overflow-y:auto;
            background:#020617;">

            @RenderBody()

        </main>

    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>

</html>